# Public URL of the Growth portal (no trailing slash).
APP_URL=https://leads.nomeriq.com

# Comma-separated extra origins allowed to call the MCP/agent endpoints from a
# browser. Blank means only APP_URL's origin is allowed. Server-to-server calls
# send no Origin header and are unaffected. Never set this to "*".
MCP_ALLOWED_ORIGINS=

# Per-API-key request limit for the MCP/agent endpoints, in requests per minute
# (fixed 60-second window, per process). Invalid or unset means 120.
API_KEY_RATE_LIMIT_PER_MIN=120

# Production: Supabase PostgreSQL pooled connection string.
# Leave empty for the local embedded Postgres (PGlite) development database.
DATABASE_URL=
PGLITE_DIR=.data/pglite
DATABASE_POOL_MAX=5

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
# Exactly 32 random bytes, base64. Encrypts SMTP/IMAP credentials at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# First-run founder seed (used by `npm run db:seed`).
ADMIN_EMAIL=founder@nomeriq.com
ADMIN_PASSWORD=
ADMIN_NAME=Founder

# sandbox = compose, record and simulate sends without contacting SMTP.
# live = send through the connected IONOS/SMTP account.
EMAIL_DELIVERY_MODE=sandbox

# AI is optional. Without it, Growth uses a deterministic draft writer.
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# DeepSeek powers the autonomous research engine (official Search and Fetch
# tools plus chat). The key is server-only; it is never sent to the browser.
# It can also be saved at runtime in Growth → Settings → DeepSeek, which
# stores it encrypted with APP_ENCRYPTION_KEY and overrides this value.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional. Any DeepSeek-compatible host may be used as the base URL above, and
# such a gateway may mount Search and Fetch somewhere other than DeepSeek's
# proprietary /v1/tools/search and /v1/tools/fetch (a common convention is
# /v1/search plus /v1/scrape). Leave these blank and "Test connection" probes
# the known conventions and remembers what answered; set them to skip probing.
DEEPSEEK_SEARCH_PATH=
DEEPSEEK_FETCH_PATH=

# Autonomous engine worker. /api/cron/research drives due jobs; Vercel Cron
# sends Authorization: Bearer $CRON_SECRET. Research only — no email is sent.
# How many due jobs one worker invocation may advance.
RESEARCH_WORKER_MAX_JOBS=3

# Protects /api/cron/follow-ups and /api/cron/research.
# Vercel Cron sends: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Development can auto-migrate. Set false in production and run `npm run db:migrate`.
AUTO_MIGRATE=true

# Local production preview only. Never set this on Vercel.
# ALLOW_PGLITE_PRODUCTION=true
