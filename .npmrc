# Refuse to run on the wrong npm. npm 11 writes package-lock.json without the `optional`
# flag on hoisted platform packages (for example @esbuild/aix-ppc64), which makes `npm ci`
# fail on every platform — and it has also written a dependency entry with no version.
# See AGENTS.md rule 10. The server runs npm 10.9.x; match it.
engine-strict=true
