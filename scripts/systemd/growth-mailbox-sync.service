[Unit]
Description=Growth mailbox scheduled sync
After=network-online.target
Wants=network-online.target
OnFailure=growth-cron-alert.service

[Service]
Type=oneshot
User=root
Group=root
RuntimeDirectory=growth-mailbox-sync
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/local/lib/growth-mailbox-sync/mailbox-sync-storage-check.sh
ExecStart=/usr/local/lib/growth-mailbox-sync/growth-cron-sync.sh
TimeoutStartSec=300
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
